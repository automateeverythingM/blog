---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { groupPostsByTag } from '../../lib/groupPostsByTag.ts';
import { isPostPublished } from '../../lib/isPostPublished.ts';

// Hidden (draft/scheduled) posts never contribute a tag or a count here,
// matching every other place posts are listed (see isPostPublished.ts).
const posts = await getCollection('blog', (post) => isPostPublished(post.data));

const tags = groupPostsByTag(posts)
	.map(({ slug, tag, count }) => ({ slug, tag, count }))
	.sort((a, b) => a.tag.localeCompare(b.tag));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tags | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				padding: 0.5em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			a {
				text-decoration: none;
			}
			a:hover {
				color: rgb(var(--accent));
			}
			.count {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Tags</h1>
			{tags.length === 0 ? (
				<p>No tags yet.</p>
			) : (
				<ul>
					{tags.map(({ slug, tag, count }) => (
						<li>
							<a href={`/tags/${slug}/`}>{tag}</a>{' '}
							<span class="count">
								({count} post{count === 1 ? '' : 's'})
							</span>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
