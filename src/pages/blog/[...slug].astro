---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import HeaderLink from '../../components/HeaderLink.astro';
import { isPostPublished } from '../../lib/isPostPublished.ts';
import { getReadingTimeMinutes } from '../../lib/readingTime.ts';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	// No page is built for a draft or not-yet-scheduled post, so it's unreachable on the site.
	const posts = (await getCollection('blog')).filter((post) => isPostPublished(post.data));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const minutesToRead = getReadingTimeMinutes(post.body ?? '');
---

<BlogPost {...post.data} minutesToRead={minutesToRead} comments>
	{/*
		Posts author custom components (e.g. using-mdx.mdx's <HeaderLink>) without
		an ESM `import` statement, because Keystatic's `fields.mdx` editor (see
		`keystatic.config.ts`) can't parse a plain `import` inside the document.
		Passing them here instead keeps every post editable in Keystatic while
		rendering exactly as if the component had been imported in the file.
	*/}
	<Content components={{ HeaderLink }} />
</BlogPost>
